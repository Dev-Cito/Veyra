meta {
  name: Tâche à échéance +48 h
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/workspaces/{{ws1}}/lists/{{list2}}/tasks
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "title": "Échéance lointaine",
    "dueDate": "{{due48h}}"
  }
}

script:pre-request {
  bru.setVar('due48h', new Date(Date.now() + 48*3600*1000).toISOString());
}

assert {
  res.status: eq 201
}

docs {
  Hors de la fenêtre de 24 h : elle ne doit PAS être traitée.
}
