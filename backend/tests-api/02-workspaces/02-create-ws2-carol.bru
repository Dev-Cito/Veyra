meta {
  name: Carol crée WS2
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workspaces
  body: json
  auth: none
}

headers {
  Cookie: {{carolCookie}}
}

body:json {
  {
    "name": "Studio Carol {{runId}}"
  }
}

script:post-response {
  const b = res.getBody() || {};
  bru.setVar('ws2', b.id);
}

assert {
  res.status: eq 201
}

docs {
  Deuxième workspace créé maintenant : il sert de base au test d'IDOR du dossier 06.
}
