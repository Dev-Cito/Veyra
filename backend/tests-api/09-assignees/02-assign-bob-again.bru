meta {
  name: Assigner Bob deux fois
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workspaces/{{ws1}}/tasks/{{m2}}/assignees
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "userId": "{{bobId}}"
  }
}

assert {
  res.status: eq 409
}

docs {
  409 et non 500 : la violation de la contrainte UNIQUE ne doit jamais remonter brute au client.
}
