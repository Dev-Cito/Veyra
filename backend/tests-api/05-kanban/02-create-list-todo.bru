meta {
  name: Liste « À faire »
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workspaces/{{ws1}}/boards/{{board1}}/lists
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "name": "À faire"
  }
}

script:post-response {
  const b = res.getBody() || {};
  bru.setVar('list1', b.id);
}

assert {
  res.status: eq 201
}
