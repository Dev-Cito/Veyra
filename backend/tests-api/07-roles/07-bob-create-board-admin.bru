meta {
  name: Bob (ADMIN) crée un board
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/workspaces/{{ws1}}/boards
  body: json
  auth: none
}

headers {
  Cookie: {{bobCookie}}
}

body:json {
  {
    "name": "Board de Bob admin"
  }
}

script:post-response {
  const b = res.getBody() || {};
  bru.setVar('board3', b.id);
}

assert {
  res.status: eq 201
}
