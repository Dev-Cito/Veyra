meta {
  name: Réinviter Bob, déjà membre
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/workspaces/{{ws1}}/invitations
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "email": "bob-{{runId}}@veyra.test",
    "role": "MEMBER"
  }
}

assert {
  res.status: eq 409
}
