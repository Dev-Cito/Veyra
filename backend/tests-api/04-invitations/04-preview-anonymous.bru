meta {
  name: Preview du token (anonyme)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/invitations/preview
  body: json
  auth: none
}

body:json {
  {
    "token": "{{bobInviteToken}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("n'expose que le strict nécessaire", function() {
    const raw = JSON.stringify(res.getBody());
    expect(raw).to.not.include("@veyra.test");   // pas l'email invité
    expect(raw).to.not.include(bru.getVar('ws1'));  // pas l'identifiant du workspace
    expect(raw).to.not.include("tokenHash");
  });
}

docs {
  Endpoint PUBLIC : tout ce qu'il renvoie est accessible à quiconque détient le token.
}
