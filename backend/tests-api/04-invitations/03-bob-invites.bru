meta {
  name: Bob (non-membre) invite
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/workspaces/{{ws1}}/invitations
  body: json
  auth: none
}

headers {
  Cookie: {{bobCookie}}
}

body:json {
  {
    "email": "y-{{runId}}@veyra.test",
    "role": "MEMBER"
  }
}

assert {
  res.status: eq 403
}
