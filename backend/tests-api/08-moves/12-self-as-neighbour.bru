meta {
  name: La tâche comme son propre voisin
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/workspaces/{{ws1}}/tasks/{{m2}}/move
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "targetListId": "{{list2}}",
    "previousTaskId": "{{m2}}",
    "nextTaskId": null
  }
}

assert {
  res.status: eq 400
}
