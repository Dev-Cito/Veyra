meta {
  name: M3 en queue
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/workspaces/{{ws1}}/tasks/{{m3}}/move
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "targetListId": "{{list2}}",
    "previousTaskId": "{{m2}}",
    "nextTaskId": null
  }
}

assert {
  res.status: eq 200
}
