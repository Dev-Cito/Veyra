meta {
  name: Réordonner un board
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/workspaces/{{ws1}}/boards/{{board3}}/move
  body: json
  auth: none
}

headers {
  Cookie: {{aliceCookie}}
}

body:json {
  {
    "previousBoardId": null,
    "nextBoardId": "{{board1}}"
  }
}

assert {
  res.status: eq 200
}
