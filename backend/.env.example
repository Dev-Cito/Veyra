DATABASE_URL=postgresql://veyra:veyra@localhost:5433/veyra
DATABASE_SSL=false
JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000
# IANA time zone for email dates when the recipient's is unknown.
DEFAULT_TIMEZONE=Africa/Kigali
# Set to "production" on Render: auth cookie becomes Secure + SameSite=None.
NODE_ENV=development
# Optional: e2e database (defaults to DATABASE_URL with a "_test" suffix).
# DATABASE_URL_TEST=

# ─── Email (optional) ───────────────────────────────────────────────────
# The app boots and works without any of these: with MAIL_ENABLED other than
# "true", or an incomplete SMTP configuration, emails are logged, not sent.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); "false" upgrades with STARTTLS.
SMTP_SECURE=false
# Both or neither.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Veyra <no-reply@example.com>"
