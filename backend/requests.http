# Veyra API — manual checks (VS Code "REST Client" extension).
# Cookies are kept between requests, so run "login" once and the httpOnly
# access_token is sent automatically afterwards.
#
# Membership management needs a second user in the workspace. There is no
# invitation endpoint yet (phase 2), so add one manually, e.g.:
#   docker exec -it veyra-db-1 psql -U veyra -d veyra -c \
#     "INSERT INTO workspace_members (\"workspaceId\", \"userId\", role, status, \"joinedAt\")
#      VALUES ('<workspaceId>', '<userId>', 'MEMBER', 'ACTIVE', now());"

@baseUrl = http://localhost:3001
@email = alice@veyra.dev
@password = correct-horse-battery

### ─── Auth ──────────────────────────────────────────────────────────────

### Register (first run only; 409 if the email exists)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "name": "Alice",
  "password": "{{password}}"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Current user
GET {{baseUrl}}/auth/me

### ─── Workspaces ────────────────────────────────────────────────────────

### 1. Create a workspace (caller becomes OWNER)
# createdById is set once and never reassigned; it becomes null if the
# creator account is deleted.
# @name createWorkspace
POST {{baseUrl}}/workspaces
Content-Type: application/json

{
  "name": "Équipe Produit"
}

@workspaceId = {{createWorkspace.response.body.$.id}}

### 2. List my workspaces (ACTIVE memberships, with my role)
GET {{baseUrl}}/workspaces

### 3. Workspace detail (any member)
GET {{baseUrl}}/workspaces/{{workspaceId}}

### 4. Rename (OWNER, ADMIN). The slug is kept stable.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}
Content-Type: application/json

{
  "name": "Équipe Produit & Design"
}

### 5. List members (any member)
# @name listMembers
GET {{baseUrl}}/workspaces/{{workspaceId}}/members

# First row = the creator. Change the index to target another member.
@memberId = {{listMembers.response.body.$[0].id}}

### 6. Change a member's role (OWNER only)
# On your own membership this returns 403 (you cannot change your own role).
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/members/{{memberId}}
Content-Type: application/json

{
  "role": "ADMIN"
}

### ─── Boards (phase 2) ──────────────────────────────────────────────
# Run these before 7 and 8, which remove your membership / the workspace.
# position is always computed by the server; sending it returns 400.
# Every DELETE returns 200 with a body describing what was removed.

### Create a board (OWNER, ADMIN)
# @name createBoard
POST {{baseUrl}}/workspaces/{{workspaceId}}/boards
Content-Type: application/json

{
  "name": "Roadmap",
  "description": "Q4 delivery"
}

@boardId = {{createBoard.response.body.$.id}}

### List boards (any member), by position
GET {{baseUrl}}/workspaces/{{workspaceId}}/boards

### Board detail (any member)
GET {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}

### Full Kanban view (any member): lists > tasks > assignees, one SQL query
GET {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}/full

### Update a board (OWNER, ADMIN). description: null clears it.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}
Content-Type: application/json

{
  "name": "Roadmap 2026",
  "description": null
}

### ─── Lists ────────────────────────────────────────────────────────────

### Create a list (OWNER, ADMIN)
# @name createList
POST {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}/lists
Content-Type: application/json

{
  "name": "To do"
}

@listId = {{createList.response.body.$.id}}

### Rename a list (OWNER, ADMIN). boardId is rejected: moving is phase 3.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/lists/{{listId}}
Content-Type: application/json

{
  "name": "Backlog"
}

### ─── Tasks ────────────────────────────────────────────────────────────

### Create a task (any member). dueDate must not be in the past.
# @name createTask
POST {{baseUrl}}/workspaces/{{workspaceId}}/lists/{{listId}}/tasks
Content-Type: application/json

{
  "title": "Write the API docs",
  "description": "Cover the Kanban routes",
  "dueDate": "2030-01-31T17:00:00.000Z",
  "priority": "HIGH"
}

@taskId = {{createTask.response.body.$.id}}

### Task detail, with assignees (any member)
GET {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{taskId}}

### Update a task (any member). A past dueDate is allowed here; null clears it.
# listId, position and reminderSent are rejected with 400.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{taskId}}
Content-Type: application/json

{
  "priority": "LOW",
  "dueDate": null
}

### ─── Moves (phase 3) ───────────────────────────────────────────────
# The client names the neighbours it dropped the item between, never a
# position. previous null = head, next null = tail, both null = empty target
# (409 if it is not). The response carries `reindexed`: when true, the
# siblings were renumbered and should be reloaded.

### Second task, to have neighbours to move around
# @name createTask2
POST {{baseUrl}}/workspaces/{{workspaceId}}/lists/{{listId}}/tasks
Content-Type: application/json

{
  "title": "Review the API docs"
}

@task2Id = {{createTask2.response.body.$.id}}

### Move a task to the head of a list (any member)
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{task2Id}}/move
Content-Type: application/json

{
  "targetListId": "{{listId}}",
  "previousTaskId": null,
  "nextTaskId": "{{taskId}}"
}

### Move a task to the tail of a list. Any list of the workspace, any board.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{task2Id}}/move
Content-Type: application/json

{
  "targetListId": "{{listId}}",
  "previousTaskId": "{{taskId}}"
}

### Second list, to reorder lists
# @name createList2
POST {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}/lists
Content-Type: application/json

{
  "name": "Done"
}

### Move a list within its board (OWNER, ADMIN). No boardId: cross-board is unsupported.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/lists/{{createList2.response.body.$.id}}/move
Content-Type: application/json

{
  "nextListId": "{{listId}}"
}

### Move a board within its workspace (OWNER, ADMIN). Alone in its workspace: both null.
PATCH {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}/move
Content-Type: application/json

{}

### Assign a user (any member). Must be an ACTIVE member (400), once (409).
POST {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{taskId}}/assignees
Content-Type: application/json

{
  "userId": "{{login.response.body.$.id}}"
}

### Unassign a user (any member). 404 if not assigned. Returns { taskId, userId }.
DELETE {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{taskId}}/assignees/{{login.response.body.$.id}}

### Delete a task (its creator, or an OWNER / ADMIN). Returns { id }.
DELETE {{baseUrl}}/workspaces/{{workspaceId}}/tasks/{{taskId}}

### Delete a list (OWNER, ADMIN). Returns { id, deletedTasks }.
DELETE {{baseUrl}}/workspaces/{{workspaceId}}/lists/{{listId}}

### Delete a board (OWNER only). Returns { id, deletedLists, deletedTasks }.
DELETE {{baseUrl}}/workspaces/{{workspaceId}}/boards/{{boardId}}

### 7. Remove a member (OWNER, ADMIN)
# On the last active OWNER this returns 409. Also drops their task assignments
# in this workspace. Returns { workspaceId, userId, removedAssignments }.
DELETE {{baseUrl}}/workspaces/{{workspaceId}}/members/{{memberId}}

### 8. Delete the workspace (OWNER only; everything in it cascades)
# Returns { id, deletedBoards, deletedLists, deletedTasks, deletedMembers }.
DELETE {{baseUrl}}/workspaces/{{workspaceId}}

### Logout
POST {{baseUrl}}/auth/logout

### ─── Invitations (phase 4) ──────────────────────────────────────────
# Full flow: the OWNER invites an email, the invitee previews the invitation,
# creates an account with that email and accepts. No email is sent yet
# (phase 5): the raw token comes back once, in the creation response.
# This section switches the session to the invitee: run it last.

@inviteeEmail = bob@veyra.dev

### Log back in as the OWNER
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Workspace for the invitation flow
# @name inviteWorkspace
POST {{baseUrl}}/workspaces
Content-Type: application/json

{
  "name": "Invitation demo"
}

@inviteWorkspaceId = {{inviteWorkspace.response.body.$.id}}

### Invite an email (OWNER, ADMIN). role: ADMIN (OWNER only) or MEMBER; OWNER -> 400.
# 409 if the email is already an active member or already has a pending invitation.
# @name createInvitation
POST {{baseUrl}}/workspaces/{{inviteWorkspaceId}}/invitations
Content-Type: application/json

{
  "email": "{{inviteeEmail}}",
  "role": "MEMBER"
}

@invitationToken = {{createInvitation.response.body.$.token}}

### List pending invitations (OWNER, ADMIN): not accepted, revoked or expired
GET {{baseUrl}}/workspaces/{{inviteWorkspaceId}}/invitations

### Public preview (no authentication needed): workspaceName, role, invitedByName, expiresAt
# The token goes in the body, never in the URL (it would end up in access logs).
# Any unusable or malformed token -> the same 404. Rate limited: 20/min per IP.
POST {{baseUrl}}/invitations/preview
Content-Type: application/json

{
  "token": "{{invitationToken}}"
}

### Revocation example: a second invitation, revoked right away
# @name toRevoke
POST {{baseUrl}}/workspaces/{{inviteWorkspaceId}}/invitations
Content-Type: application/json

{
  "email": "carol@veyra.dev",
  "role": "MEMBER"
}

### Revoke it (OWNER, ADMIN). Returns { id, email, revokedAt }; the row is kept.
DELETE {{baseUrl}}/workspaces/{{inviteWorkspaceId}}/invitations/{{toRevoke.response.body.$.id}}

### The invitee creates an account with the invited email (409 if it exists: log in instead)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{inviteeEmail}}",
  "name": "Bob",
  "password": "{{password}}"
}

### Accept (authenticated). 403 if signed in with another email; 404 if unusable.
# Rate limited: 10/min per IP (429 beyond).
POST {{baseUrl}}/invitations/accept
Content-Type: application/json

{
  "token": "{{invitationToken}}"
}

### The invitee now sees the workspace
GET {{baseUrl}}/workspaces
